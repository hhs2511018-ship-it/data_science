    let currentMode = 'practice';
    let userScores = {};

    function renderQuestions() {
        const container = document.getElementById('quiz-container');
        container.innerHTML = '';

        questions.forEach(q => {
            userScores[q.id] = q.minScore; // 기본 최하점 초기화
            const card = document.createElement('div');
            card.className = 'step-card';
            card.id = `card-${q.id}`;

            card.innerHTML = `
                <div class="step-header">
                    <div class="step-title">${q.title}</div>
                    <div class="step-meta">
                        <span class="badge-diff ${q.diffClass}">${q.diff}</span>
                        <span style="font-weight:700; color:var(--primary);">배점: ${q.maxScore}점</span>
                    </div>
                </div>
                <div class="step-desc">${q.desc}</div>
                <textarea class="code-input" id="input-${q.id}" placeholder="${q.placeholder}" onkeydown="handleTab(event, this)"></textarea>
                <div class="btn-group">
                    <button class="btn btn-check" onclick="gradeOne(${q.id})">채점하기</button>
                    <button class="btn btn-hint practice-only" onclick="toggleBox('hint-${q.id}')">💡 힌트 보기</button>
                    <button class="btn btn-ans practice-only" onclick="toggleBox('ans-${q.id}')">👀 정답 보기</button>
                </div>
                <div class="hint-box" id="hint-${q.id}"><strong>힌트:</strong> ${q.hint}</div>
                <div class="answer-box" id="ans-${q.id}">${q.answer}</div>
                <div class="feedback-box" id="fb-${q.id}"></div>
            `;
            container.appendChild(card);
        });
        updateTotalScore();
    }

    function handleTab(e, textarea) {
        if (e.key === 'Tab') {
            e.preventDefault();
            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            textarea.value = textarea.value.substring(0, start) + "    " + textarea.value.substring(end);
            textarea.selectionStart = textarea.selectionEnd = start + 4;
        }
    }

    function toggleBox(id) {
        const el = document.getElementById(id);
        el.style.display = (el.style.display === 'block') ? 'none' : 'block';
    }

    function toggleRubric() {
        const content = document.getElementById('rubric-content');
        const arrow = document.getElementById('rubric-arrow');
        content.classList.toggle('open');
        arrow.textContent = content.classList.contains('open') ? '▲' : '▼';
    }

    function setMode(mode) {
        currentMode = mode;
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        
        const quizContainer = document.getElementById('quiz-container');
        const bottomActions = document.getElementById('bottom-actions');
        const fullAnsView = document.getElementById('full-answer-view');

        if (mode === 'answer') {
            document.getElementById('btn-mode-ans').classList.add('active');
            quizContainer.style.display = 'none';
            bottomActions.style.display = 'none';
            fullAnsView.style.display = 'block';
            return;
        }

        quizContainer.style.display = 'block';
        bottomActions.style.display = 'flex';
        fullAnsView.style.display = 'none';

        if (mode === 'practice') {
            document.getElementById('btn-mode-practice').classList.add('active');
            document.querySelectorAll('.practice-only').forEach(el => el.style.display = 'inline-block');
        } else {
            document.getElementById('btn-mode-exam').classList.add('active');
            document.querySelectorAll('.practice-only').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.hint-box, .answer-box').forEach(el => el.style.display = 'none');
        }
    }

    function normalizeCode(str) {
        return str.replace(/\s+/g, ' ').replace(/\s*\(\s*/g, '(').replace(/\s*\)\s*/g, ')').replace(/\s*=\s*/g, '=').replace(/\s*,\s*/g, ',').trim();
    }

    function gradeOne(id) {
        const q = questions.find(item => item.id === id);
        const rawInput = document.getElementById(`input-${id}`).value;
        const normInput = normalizeCode(rawInput);
        const card = document.getElementById(`card-${id}`);
        const fb = document.getElementById(`fb-${id}`);

        card.classList.remove('correct', 'partial', 'wrong');
        fb.classList.remove('fb-success', 'fb-partial', 'fb-error');

        if (!normInput) {
            userScores[id] = q.minScore;
            card.classList.add('wrong');
            fb.classList.add('fb-error');
            fb.textContent = `❌ 미작성 (채점 기준 최하점: ${q.minScore}점 / ${q.maxScore}점)`;
            updateTotalScore();
            return;
        }

        let matchedGroups = 0;
        q.keywords.forEach(group => {
            const isGroupMatched = group.some(kw => normInput.includes(normalizeCode(kw)));
            if (isGroupMatched) matchedGroups++;
        });

        if (matchedGroups === q.keywords.length) {
            userScores[id] = q.maxScore;
            card.classList.add('correct');
            fb.classList.add('fb-success');
            fb.textContent = `✅ 정확합니다! 만점 (${q.maxScore}점 / ${q.maxScore}점)`;
        } else if (matchedGroups > 0) {
            const partialScore = q.maxScore - 1;
            userScores[id] = partialScore;
            card.classList.add('partial');
            fb.classList.add('fb-partial');
            fb.textContent = `⚠️ 부분 정답입니다. 누락된 코드가 있는지 확인해보세요! (${partialScore}점 / ${q.maxScore}점)`;
        } else {
            userScores[id] = q.minScore;
            card.classList.add('wrong');
            fb.classList.add('fb-error');
            fb.textContent = `❌ 핵심 명령어가 부족합니다. 다시 작성해보세요. (${q.minScore}점 / ${q.maxScore}점)`;
        }

        updateTotalScore();
    }

    function gradeAll() {
        questions.forEach(q => gradeOne(q.id));
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function resetAll() {
        if (!confirm("작성한 모든 코드를 초기화할까요?")) return;
        questions.forEach(q => {
            document.getElementById(`input-${q.id}`).value = '';
            document.getElementById(`card-${q.id}`).classList.remove('correct', 'partial', 'wrong');
            const fb = document.getElementById(`fb-${q.id}`);
            fb.className = 'feedback-box';
            fb.textContent = '';
            userScores[q.id] = q.minScore;
        });
        updateTotalScore();
    }

    function updateTotalScore() {
        let sum = 0;
        for (let id in userScores) {
            sum += userScores[id];
        }
        document.getElementById('total-score-display').textContent = `예상 점수: ${sum} / 25점 (미작성 시 기본 8점 포함)`;
    }

    renderQuestions();
</script>

